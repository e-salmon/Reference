{
    "files.trimTrailingWhitespace": true,
    "files.trimFinalNewlines": true,
    "workbench.colorTheme": "Jellybeans",
    "workbench.iconTheme": "vscode-icons",
    "workbench.colorCustomizations": {
        "editor.background": "#181818",
        "editor.guides.indentation": true,
        "editor.guides.highlightActiveIndentation": true,
        "minimap.background": "#0f0f0f",
        "editorBracketHighlight.foreground1": "#B200FF",
        "editorBracketHighlight.foreground2": "#FF4500",
        "editorBracketHighlight.foreground3": "#FFA500",
        "editorBracketHighlight.foreground4": "#BDB76B",
        "editorBracketHighlight.foreground5": "#20B2AA",
        "editorBracketHighlight.foreground6": "#1E90FF",
        "editorBracketHighlight.unexpectedBracket.foreground": "#db6165",
        "editorIndentGuide.background1": "#59007F",
        "editorIndentGuide.background2": "#7F2200",
        "editorIndentGuide.background3": "#7F5200",
        "editorIndentGuide.background4": "#5E5B35",
        "editorIndentGuide.background5": "#105955",
        "editorIndentGuide.background6": "#0F487F",
        "editorIndentGuide.activeBackground1": "#59007F",
        "editorIndentGuide.activeBackground2": "#7F2200",
        "editorIndentGuide.activeBackground3": "#7F5200",
        "editorIndentGuide.activeBackground4": "#5E5B35",
        "editorIndentGuide.activeBackground5": "#105955",
        "editorIndentGuide.activeBackground6": "#0F487F",
        "activityBarBadge.foreground": "#202020",
        "activityBarBadge.background": "#01f9c6",
        "textLink.foreground": "#ffa470",
        "button.foreground": "#000000",
        "button.background": "#ffa470",
        "extensionButton.foreground": "#000000",
        "extensionButton.background": "#01f9c6",
        "extensionButton.prominentForeground": "#000000",
        "extensionButton.prominentBackground": "#01f9c6",
        // Overrides Theme Default Colors for InlayHints feature
        "editorInlayHint.foreground": "#787878cc",
        "editorInlayHint.background": "#00001CCC",
        // Overrides Theme Parameter hints fg for InlayHints feature
        "editorInlayHint.parameterForeground": "#787878cc",
        "editorInlayHint.parameterBackground": "#00001CCC",
        // Overrides Theme Type hints fg for InlayHints feature
        "editorInlayHint.typeForeground": "#787878cc",
        "editorInlayHint.typeBackground": "#08000088",
        // Diff
        "diffEditor.insertedTextBackground": "#00cc001c",    // previous
        "diffEditor.removedTextBackground": "#cc000022",     // previous
        "diffEditor.insertedLineBackground": "#2273381c",
        "diffEditor.removedLineBackground": "#72333333",
        // Coverage Gutters
        "diffEditorGutter.insertedLineBackground": "#22733866",
        "diffEditorGutter.removedLineBackground": "#72333366",
        "diffEditorOverview.insertedForeground": "#22733866",
        "diffEditorOverview.removedForeground": "#72333366",
        // Peekview
        "peekViewEditor.background": "#0c1420",
        "peekViewResult.background": "#08101c"
    },
    "workbench.editor.revealIfOpen": true,
    "workbench.editor.tabSizing": "fixed",
    "workbench.view.alwaysShowHeaderActions": true,
    "markdown.preview.fontSize": 12,
    "security.workspace.trust.untrustedFiles": "open",
    "editor.fontFamily": "'CaskaydiaCove Nerd Font',Fira Code,Consolas, 'Courier New', monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 12,
    "editor.stickyTabStops": true,
    "editor.minimap.showSlider": "always",
    "editor.semanticHighlighting.enabled": true,
    "editor.renderLineHighlight": "all",
    "editor.renderWhitespace": "all",
    "editor.minimap.size": "fit",
    "editor.mouseWheelZoom": true,
    "window.confirmSaveUntitledWorkspace": false,
    "explorer.fileNesting.enabled": true,
    "github.gitAuthentication": false,
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.replaceTagsWhenPull": true,
    "git.terminalAuthentication": false,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.mouseWheelZoom": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "git-graph.date.format": "ISO Date & Time",
    "csharp.inlayHints.enableInlayHintsForTypes": true,
    "dotnet.inlayHints.suppressInlayHintsForParametersThatMatchMethodIntent": true,
    "dotnet.inlayHints.suppressInlayHintsForParametersThatDifferOnlyBySuffix": true,
    "dotnet.inlayHints.enableInlayHintsForIndexerParameters": true,
    "dotnet.inlayHints.enableInlayHintsForLiteralParameters": true,
    "debug.openDebug": "openOnDebugBreak",
    "editor.tabCompletion": "off",
    "files.defaultLanguage": "",
    "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
    "powershell.buttons.showPanelMovementButtons": false,
    "powershell.codeFolding.showLastLine": true,
    "powershell.sideBar.CommandExplorerVisibility": false,
    "git.pruneOnFetch": true,
    "editor.semanticTokenColorCustomizations": {
        "[Jellybeans]": {
            "rules": {
                "property": "#d6cebb",
                "interface": "#73b663",
                "namespace": "#d77F3c",
                "extensionMethod": "#48a4ff",
                "operator": "#4ac788",
                "parameter": "#ffffff",
                "enum": "#c24ba5",
                "enumMember": "#d87daa",
                "variable": "#a0a0a0",
                "comment": "#986363",
                "xmlDocCommentDelimiter": "#6c3e3e",
                "xmlDocCommentName": "#6c3e3e",
                "xmlDocCommentText": "#a46060",
                "xmlDocCommentAttributeName": "#c8c8c8",
                "struct": "#86c691",
            }
        }
    },
    "editor.tokenColorCustomizations": {
        "[Jellybeans]": {
            "textMateRules": [
                {
                    "scope": [
                        "support.type.property-name",
                        "entity.name.tag.yaml"
                    ],
                    "settings": {
                        "foreground": "#8197bf"
                    }
                },
                {
                    "scope": [
                        "string.quoted.single.yaml"
                    ],
                    "settings": {
                        "foreground": "#d77F3c"
                    }
                },
                {
                    "scope": [
                        "comment.line.number-sign.yaml",
                        "comment.line.double-slash.js",
                        "comment"
                    ],
                    "settings": {
                        "foreground": "#986363"
                    }
                },
                {
                    "scope": [
                        "punctuation.definition.comment.yaml",
                        "punctuation.definition.comment"
                    ],
                    "settings": {
                        "foreground": "#986363"
                    }
                }
            ]
        }
    },
    "explorer.confirmDragAndDrop": false,
    "git.fetchOnPull": true,
    "dotnet.automaticallyCreateSolutionInWorkspace": false,
    "editor.wordWrapColumn": 135,
    "editor.wordWrap": "wordWrapColumn",
    "livePreview.notifyOnOpenLooseFile": false,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "dotnet.inlayHints.suppressInlayHintsForParametersThatMatchArgumentName": true,
    "terminal.integrated.fontSize": 13,
    "cSpell.language": "en-GB",
    "csharp.inlayHints.enableInlayHintsForImplicitVariableTypes": true,
    "dotnet.inlayHints.enableInlayHintsForObjectCreationParameters": true,
    "cSpell.ignoreWords": [
        "Newtonsoft",
        "SAPCONCUR"
    ],
    "cSpell.userWords": [
        "baseuri",
        "Behavior",
        "Contrib",
        "Deserialised",
        "Everbridge",
        "Iata",
        "Memberwise",
        "Pnrs",
        "Replacer",
        "Timezone",
        "Traveler",
        "Traxo"
    ],
    "workbench.startupEditor": "none",
    "github.copilot.advanced": {},
    "[markdown]": {
        "files.trimTrailingWhitespace": false
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "explorer.excludeGitIgnore": true,
    "dotnet.projects.enableFileBasedPrograms": false,
    "vsicons.dontShowNewVersionMessage": true,
    "git-graph.graph.colours": [
        "#d98500",
        "#d9008f",
        "#0085d9",
        "#ffcc00",
        "#00d90a",
        "#a300d9",
        "#ff0000",
        "#00d9cc",
        "#e138e8",
        "#85d900",
        "#dc5b23",
        "#6f24d6"
    ],
    "files.exclude": {
        "**/desktop.ini": true
    },
    "python.analysis.typeCheckingMode": "standard",
    "mdb.mcp.server": "autoStartDisabled",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "chat.viewSessions.enabled": false,
    "diffEditor.hideUnchangedRegions.enabled": true
}
